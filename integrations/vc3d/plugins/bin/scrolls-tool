#!/usr/bin/env python3
"""Launcher for VC3D's plugin host: runs `python -m kit tools ARGS` from a Scrolls checkout (written by
python -m kit tools export-vc3d; SCROLLS_KIT_ROOT overrides where kit is)."""
import os
import sys
from pathlib import Path

ROOT = Path(os.environ['SCROLLS_KIT_ROOT']) if os.environ.get('SCROLLS_KIT_ROOT') else Path(__file__).resolve().parents[4]
sys.path.insert(0, str(ROOT))
from kit import toolreg  # noqa: E402

sys.exit(toolreg.launch(sys.argv[1:]))
